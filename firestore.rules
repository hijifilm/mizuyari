rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function fam(fid) { return get(/databases/$(database)/documents/families/$(fid)); }
    function isMember(fid) { return signedIn() && request.auth.uid in fam(fid).data.members; }

    // 自分が入っている家族グループの番号は、自分だけが読み書きできます
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (request.method == 'delete' || request.resource.data.keys().hasOnly(['fid']));
    }

    // 招待コード → 家族グループ。コードを知っている人だけが1件ずつ引けます(一覧は不可)
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fid'])
        && request.auth.uid in getAfter(/databases/$(database)/documents/families/$(request.resource.data.fid)).data.members;
      allow delete: if signedIn() && isMember(resource.data.fid);
      allow update: if false;
    }

    // 家族グループ
    match /families/{fid} {
      allow get: if isMember(fid);
      allow list: if false;
      // 作る: 自分ひとりだけのグループ
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'code'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 6 && request.resource.data.code.size() <= 12;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'code'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.members.size() <= 10
        && (
          // メンバーが、抜ける(人数が増えない)
          ( request.auth.uid in resource.data.members
            && request.resource.data.members.hasOnly(resource.data.members) )
          ||
          // 招待コードを使って、自分が1人だけ加わる
          ( !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1 )
        );
      // 最後の1人が抜けるとき、グループごと消せます
      allow delete: if isMember(fid) && fam(fid).data.members.size() == 1;

      // 植物のデータと写真は、メンバーだけが読み書きできます
      match /data/{doc} {
        allow read, write: if isMember(fid);
      }
      match /pimg/{doc} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid)
          && request.resource.data.keys().hasOnly(['v', 'by', 'img'])
          && request.resource.data.img is string
          && request.resource.data.img.size() < 200000;
      }
    }
  }
}
